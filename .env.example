# Copy to .env and fill in. Never commit .env.

# --- LLM provider (Groq, OpenAI-compatible) ---------------------------------
GROQ_API_KEY=
# AR_LLM_BASE_URL=https://api.groq.com/openai/v1

# --- runtime ------------------------------------------------------------------
AR_ENV=dev
AR_LOG_LEVEL=INFO
AR_LOG_JSON=false
AR_DEFAULT_STRATEGY=adaptive

# --- storage (defaults match docker-compose.yml) ------------------------------
AR_DATABASE_URL=postgresql+asyncpg://adaptiveroute:adaptiveroute@localhost:5432/adaptiveroute
AR_REDIS_URL=redis://localhost:6379/0

# --- security -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AR_API_KEY_PEPPER=dev-only-pepper-change-me
AR_RATE_LIMIT_PER_MINUTE=60
AR_RATE_LIMIT_BURST=20

# --- embeddings ---------------------------------------------------------------
AR_EMBEDDING_BACKEND=fastembed
AR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- observability ------------------------------------------------------------
AR_OTEL_ENABLED=false
AR_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
AR_TRACE_QUERY_URL=http://localhost:16686
